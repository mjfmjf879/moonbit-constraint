name = "lqhy1234567/moonbit_constraint"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/mjfmjf879/moonbit-constraint"

license = "Apache-2.0"

keywords = [
  "constraint-programming",
  "finite-domain",
  "scheduling",
  "optimization",
]

preferred_target = "wasm-gc"

description = "Finite-domain constraint programming library for MoonBit"
